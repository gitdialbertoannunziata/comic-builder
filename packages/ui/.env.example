# Copia questo file in `.env.local` e riempilo. `.env.local` è ignorato da git.
#
# Attenzione: Vite incorpora le variabili VITE_* nel codice che serve al
# browser. L'applicazione le legge solo in modalità sviluppo (`pnpm dev`),
# proprio per impedire che un `pnpm build` porti la chiave dentro il bundle.

# Chiave API di Anthropic. Se presente, la scheda Copione parte già compilata.
VITE_ANTHROPIC_API_KEY=sk-ant-...

# Facoltativi: valori di partenza dei campi.
# VITE_ANTHROPIC_MODEL=claude-opus-5
# VITE_OLLAMA_HOST=http://localhost:11434
# VITE_OLLAMA_MODEL=mistral

# Chiave API di DeepSeek.
# VITE_DEEPSEEK_API_KEY=sk-...
# VITE_DEEPSEEK_MODEL=deepseek-flash

# Chiave API di OpenAI.
# VITE_OPENAI_API_KEY=sk-...
# VITE_OPENAI_MODEL=gpt-6-astra
# VITE_OPENAI_BASE_URL=https://api.openai.com/v1

# Arte generata con FLUX.2 [pro], da uno dei due fornitori.
# Su Azure AI Foundry: endpoint della risorsa (va bene anche quello del
# progetto), chiave della risorsa, nome del deployment.
# VITE_AZURE_FLUX_ENDPOINT=https://<risorsa>.services.ai.azure.com
# VITE_AZURE_FLUX_API_KEY=...
# VITE_AZURE_FLUX_DEPLOYMENT=FLUX.2-pro

# Oppure direttamente da Black Forest Labs.
# VITE_BFL_API_KEY=...
# VITE_BFL_MODEL=flux-2-pro
# Globale di default; api.eu.bfl.ai o api.us.bfl.ai per restare in una regione.
# VITE_BFL_BASE_URL=https://api.bfl.ai
